# Improved rule-guided questioner simulation

questions = []
answers = []
keyword = "tanzania"
category = "place"

def improved_questioner(questions, answers):
    step = len(questions)

    if step == 0:
        return "Is it a place?"
    elif step == 1:
        return "Is it a country?"
    elif step == 2:
        return "Is it located in Africa?"
    elif step == 3:
        return "Is it known for wildlife or safaris?"
    else:
        return "Is it Tanzania?"

def improved_guess(questions, answers):
    joined_q = " ".join(questions).lower()
    joined_a = " ".join(answers).lower()

    if "tanzania" in joined_q and "yes" in joined_a:
        return "tanzania"
    if "africa" in joined_q and "yes" in joined_a:
        return "tanzania"
    if "country" in joined_q and "yes" in joined_a:
        return "tanzania"

    return "country"

def simple_answer(question, keyword="tanzania"):
    q = question.lower()

    if "person" in q:
        return "no"
    if "place" in q:
        return "yes"
    if "country" in q:
        return "yes"
    if "africa" in q:
        return "yes"
    if "wildlife" in q or "safaris" in q:
        return "yes"
    if "tanzania" in q:
        return "yes"

    return "no"

print("Improved structured baseline simulation...\n")

for i in range(1, 6):
    question = improved_questioner(questions, answers)
    questions.append(question)

    answer = simple_answer(question, keyword)
    answers.append(answer)

    guess = improved_guess(questions, answers)

    print(f"Question {i}: {question}")
    print(f"Answer: {answer}")
    print(f"Guess: {guess}\n")

